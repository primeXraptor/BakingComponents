{
  "name": "baking-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "NOTICE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/baking-components.css",
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./dashboard.css": "./dist/dashboard.css",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth.js"
    },
    "./auth.css": "./dist/auth.css",
    "./dashboard-admin": {
      "types": "./dist/styled-dashboard/admin-index.d.ts",
      "import": "./dist/dashboard-admin.js"
    },
    "./dashboard-admin.css": "./dist/dashboard-admin.css",
    "./pdf-assets/*": "./dist/pdf-assets/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build && vite build --config vite.dashboard.config.ts && vite build --config vite.auth.config.ts && vite build --config vite.admin.config.ts && node scripts/copy-pdf-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --host 0.0.0.0",
    "check:source": "node scripts/check-dashboard-source.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@untitledui/icons": "0.0.22",
    "clsx": "^2.1.1",
    "framer-motion": "12.40.0",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "6.3.289",
    "react-aria-components": "^1.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "css.escape": "^1.5.1",
    "jsdom": "^26.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
